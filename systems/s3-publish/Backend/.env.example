# System 3 API (publishing & analytics). Copy to .env in this folder.
# Reached through the Alias gateway at http://localhost:3000/svc/publishing; started by `pnpm dev:all` (internal port 3002).
PORT=3002
NODE_ENV=development

# Database Configuration (PostgreSQL)
# Create it once: docker compose exec postgres createdb -U alias social_db
DATABASE_URL=postgresql://alias:alias@localhost:5432/social_db

# Zernio API Configuration
# Replace ZERNIO_API_KEY with your actual API key in .env (never commit real key)
ZERNIO_API_KEY=sk_your_zernio_api_key_here
ZERNIO_BASE_URL=https://zernio.com/api/v1

# Auth Configuration
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d
OWNER_SETUP_TOKEN=your_one_time_setup_token_here
CLIENT_URL=http://localhost:3000

# Public Tracking Base URL Configuration
# In production, must be a public HTTPS base URL (e.g. https://trk.yourdomain.com) for tracked links to be reachable.
# In development, defaults to http://localhost:PORT
PUBLIC_TRACKING_BASE_URL=http://localhost:3002

