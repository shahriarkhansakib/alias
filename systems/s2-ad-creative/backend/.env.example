PROJECT_NAME="Alias Img-Gen"
VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=true

# Database configuration
# Development default: local async SQLite (sqlite+aiosqlite:///./alias_imggen.db)
# Production requirement: PostgreSQL with asyncpg (postgresql+asyncpg://user:password@host:5432/dbname)
DATABASE_URL="sqlite+aiosqlite:///./alias_imggen.db"

# PostgreSQL Connection Pooling (ignored on SQLite)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true


# Storage configuration
# Development default: local filesystem storage
STORAGE_PROVIDER="local"
STORAGE_TYPE="local"
LOCAL_STORAGE_PATH="./storage"
STORAGE_PUBLIC_URL_PREFIX="/api/v1/storage"

# Production S3-Compatible Object Storage (AWS S3 or Cloudflare R2)
# Set STORAGE_PROVIDER="s3" (or STORAGE_TYPE="s3") to activate.
# For AWS S3: leave S3_ENDPOINT_URL blank or set to https://s3.amazonaws.com
# For Cloudflare R2: https://<account_id>.r2.cloudflarestorage.com
S3_ENDPOINT_URL=""
S3_REGION="us-east-1"
S3_BUCKET="alias-creatives-prod"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Optional: Public CDN/domain for S3 or R2 (e.g., https://cdn.example.com or https://pub-<hash>.r2.dev)
# If omitted, private bucket objects are securely proxied through /api/v1/storage without exposing credentials.
S3_PUBLIC_BASE_URL=""


# Worker configuration
# Development default: in-process async execution (no Redis/Celery required)
WORKER_TYPE="async"

# Production Celery + Redis Worker Architecture
# Set WORKER_TYPE="celery" and configure REDIS_URL to activate.
# Startup will fail immediately if WORKER_TYPE="celery" and REDIS_URL is not set.
REDIS_URL="redis://localhost:6379/0"
CELERY_TASK_DEFAULT_QUEUE="creative"

# CORS configuration (JSON array string or comma separated)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
 
# Phase 9.2: Facebook Page Publishing & Token Encryption
# In production, AUTH_TOKEN_ENCRYPTION_KEY is required and must be 32 bytes (64 hex characters or 44 base64 characters)
ENABLE_FACEBOOK_PUBLISHING=false
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
FACEBOOK_OAUTH_REDIRECT_URI="http://localhost:8000/api/v1/publishing/oauth/facebook/callback"
AUTH_TOKEN_ENCRYPTION_KEY=""

