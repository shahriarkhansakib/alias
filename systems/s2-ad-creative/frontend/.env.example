# System 2 web (creative studio). Copy to .env.local in this folder.
# Served behind the Alias gateway at http://localhost:3000/studio; started by `pnpm dev:all` (internal port 3001).
NEXT_PUBLIC_BASE_PATH=/studio
# System 2 API, reached through the gateway on the same origin (no CORS needed)
NEXT_PUBLIC_API_URL=/svc/creative
