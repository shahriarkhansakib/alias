# System 1 — Client intake chat + operator console (Next.js, MongoDB)
# Copy to .env.local in this folder. Started by `pnpm dev:all` at the repo root (internal port 3005).

# --- Required ---
# REQUIRED for a usable demo: MongoDB Atlas (ask Afridi) or local mongodb://localhost:27017/alias_s1.
# Without it System 1 waits ~30 s per request before falling back to memory.
MONGODB_URI=
GEMINI_API_KEY=                     # Google AI Studio key: intake chat, brief synthesis, admin copilot
TAVILY_API_KEY=                     # Competitor research worker (runs after admin approves the brief)
NEXTAUTH_SECRET=                    # Any random string, 32+ chars (openssl rand -base64 32)
CRON_SECRET=                        # Random string protecting /api/admin/communication/cron

# Served behind the Alias gateway at http://localhost:3000/intake
NEXT_PUBLIC_BASE_PATH=/intake
NEXTAUTH_URL=http://localhost:3000/intake/api/auth
# The gateway already checks the platform login and admin role for /intake/admin
NEXT_PUBLIC_TRUST_GATEWAY_AUTH=true

# --- Optional ---
GEMINI_MODEL=gemini-3.5-flash-lite  # Default used in code if unset
GEMINI_FALLBACK_MODEL=
OPENAI_API_KEY=                     # Only if a fallback model provider is used
BRAVE_API_KEY=                      # Optional extra search provider
SERPAPI_API_KEY=                    # Optional extra search provider

# --- Demo / local-only switches (never enable in production) ---
ALLOW_DEMO_AUTH=true            # dev only: lets the gateway-authenticated user act as demo client/admin
ALLOW_DEMO_FALLBACK=false
ALLOW_MEMORY_FALLBACK=true
ALLOW_INSECURE_NON_TRANSACTIONAL_FALLBACK=false
