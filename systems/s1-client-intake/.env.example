# System 1 — Client intake chat + operator console (Next.js, MongoDB)
# Copy to .env.local in this folder. Run with: npm run dev -- -p 3005

# --- Required ---
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>   # MongoDB Atlas or local mongodb://localhost:27017/alias_s1
GEMINI_API_KEY=                     # Google AI Studio key: intake chat, brief synthesis, admin copilot
TAVILY_API_KEY=                     # Competitor research worker (runs after admin approves the brief)
NEXTAUTH_SECRET=                    # Any random string, 32+ chars (openssl rand -base64 32)
CRON_SECRET=                        # Random string protecting /api/admin/communication/cron

# --- Optional ---
GEMINI_MODEL=gemini-3.5-flash-lite  # Default used in code if unset
GEMINI_FALLBACK_MODEL=
OPENAI_API_KEY=                     # Only if a fallback model provider is used
BRAVE_API_KEY=                      # Optional extra search provider
SERPAPI_API_KEY=                    # Optional extra search provider

# --- Demo / local-only switches (leave false for real demos) ---
ALLOW_DEMO_AUTH=false
ALLOW_DEMO_FALLBACK=false
ALLOW_MEMORY_FALLBACK=false
ALLOW_INSECURE_NON_TRANSACTIONAL_FALLBACK=false
