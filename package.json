{
  "name": "alias",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "dev": "turbo run dev --output-logs=new-only",
    "dev:stream": "turbo run dev --ui=stream --output-logs=new-only",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint:biome": "biome lint .",
    "lint:arch": "eslint .",
    "lint": "pnpm run lint:biome && pnpm run lint:arch",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test:unit": "turbo run test:unit",
    "test:integration": "turbo run test:integration",
    "test:e2e": "turbo run test:e2e",
    "test": "pnpm run test:unit && pnpm run test:integration",
    "db:generate": "pnpm --filter @alias/api db:generate",
    "db:migrate": "pnpm --filter @alias/api db:migrate",
    "db:reset": "pnpm --filter @alias/api db:reset",
    "bootstrap:admin": "pnpm --filter @alias/api bootstrap:admin",
    "dev:doctor": "node scripts/doctor.mjs",
    "agents:sync": "node scripts/sync-agent-config.mjs",
    "agents:check": "node scripts/sync-agent-config.mjs --check",
    "test:scripts": "vitest run --config scripts/vitest.config.mjs",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs,json,css}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "devDependencies": {
    "@alias/config": "workspace:*",
    "@biomejs/biome": "^2.6.8",
    "eslint": "^10.15.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "turbo": "^2.11.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
