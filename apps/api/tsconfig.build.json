{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@alias/config/tsconfig/node",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "sourceMap": true
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.unit.test.ts",
    "src/**/*.integration.test.ts",
    "src/test/**"
  ]
}
